#!/usr/bin/env bash
# pre-push hook: enforce branch policy and verify build before pushing

# --- Branch protection ---
# Reject direct pushes to main and develop; require PRs instead.
protected_branches="^refs/heads/(main|develop)$"
rejected=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" =~ $protected_branches ]]; then
        branch_name="${remote_ref#refs/heads/}"
        echo "ERROR: Direct push to '$branch_name' is not allowed."
        echo "       Please open a pull request instead."
        rejected=1
    fi
done

if [ "$rejected" -eq 1 ]; then
    exit 1
fi

# --- Build check ---
BUILD_DIR="cmake-build-debug-msvc"

if [ ! -d "$BUILD_DIR" ]; then
    echo "pre-push: build directory '$BUILD_DIR' not found, skipping build check"
    exit 0
fi

echo "pre-push: verifying build..."
if ! cmake --build "$BUILD_DIR" --config Debug; then
    echo ""
    echo "ERROR: Build failed. Push rejected."
    echo "Fix build errors before pushing."
    exit 1
fi

echo "pre-push: build succeeded"
exit 0
