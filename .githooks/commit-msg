#!/usr/bin/env bash
# commit-msg hook: enforce conventional commit format

MSG_FILE="$1"
MSG=$(head -1 "$MSG_FILE")

# Allow merge and revert commits
if echo "$MSG" | grep -qE '^Merge '; then
    exit 0
fi
if echo "$MSG" | grep -qE '^Revert '; then
    exit 0
fi

# Validate conventional commit pattern
if ! echo "$MSG" | grep -qE '^(feat|fix|docs|style|refactor|test|chore|build|ci)(\(.+\))?: .+'; then
    echo ""
    echo "ERROR: Commit message does not follow Conventional Commits format."
    echo ""
    echo "  Expected: <type>(<scope>): <description>"
    echo ""
    echo "  Types: feat, fix, docs, style, refactor, test, chore, build, ci"
    echo "  Scope: optional, in parentheses"
    echo ""
    echo "  Examples:"
    echo "    feat(avatar): add idle animation blending"
    echo "    fix(camera): resolve crash on init with no webcam"
    echo "    chore: update dependencies"
    echo ""
    echo "  Your message: $MSG"
    echo ""
    exit 1
fi

exit 0
