# ── Build outputs ─────────────────────────────────────────────────────────────
build/
build-release/
build-vs/
bin/
obj/
out/
.cache/
cmake-build-*/

# ── IDE — CLion ───────────────────────────────────────────────────────────────
.idea/
.clion/

# ── IDE — Visual Studio ───────────────────────────────────────────────────────
.vs/
# Keep .sln and .vcxproj tracked (hand-authored VS project skeleton)
*.user
*.suo
*.VC.db
*.VC.opendb
ipch/
# MSBuild output folders inside legacy VS project directories
**/x64/
**/x86/
# MSBuild incremental build artifacts
*.recipe
*.lastbuildstate
*.tlog
*.idb

# ── IDE — VS Code ─────────────────────────────────────────────────────────────
.vscode/

# ── Compiled objects ──────────────────────────────────────────────────────────
*.o
*.obj
*.pch
*.pdb
*.ilk
*.exp

# ── Compile commands (regenerated by CMake) ───────────────────────────────────
compile_commands.json

# ── Dependencies ──────────────────────────────────────────────────────────────
# vendor/ is tracked via git submodules (.gitmodules) — do NOT ignore it
vcpkg_installed/
.vcpkg-root

# ── ML Models (large binaries — use Git LFS or download script) ───────────────
resources/models/*.onnx
resources/models/*.bin
resources/models/*.pt
resources/models/*.tflite

# ── Python training environment ───────────────────────────────────────────────
training/venv/
training/data/raw/
training/data/processed/
training/experiments/
*.pyc
__pycache__/
*.egg-info/
venv/
.env
.env.local

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Secrets ───────────────────────────────────────────────────────────────────
*.key
*.pem

# ── ImGui runtime state ───────────────────────────────────────────────────────
imgui.ini

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
